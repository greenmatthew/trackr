<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Trackr.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Trackr.Mobile.Pages"
    xmlns:vm="clr-namespace:Trackr.Mobile.Core.ViewModels;assembly=Trackr.Mobile.Core"
    Title="Trackr"
    FlyoutBehavior="Disabled">

    <!-- Four flat routes, no tabs and no flyout: the app still has exactly one signed-in
         screen, so there is nothing to navigate between. Milestone 5 (CLAUDE.md section 9)
         decides the real structure, at which point Home becomes a TabBar holding the chat and
         stats tabs and these three auth routes move out of the main stack.

         Routes come from Trackr.Mobile.Core rather than being written here as literals. They
         were duplicated once, and the failure mode was poor: renaming one side compiled and
         threw at runtime inside a fire-and-forget handler, so it looked like a dead button
         rather than a crash. RoutesTests holds the pair together if x:Static is ever undone. -->

    <ShellContent
        Route="{x:Static vm:Routes.ServerSetup}"
        ContentTemplate="{DataTemplate pages:ServerSetupPage}" />

    <ShellContent
        Route="{x:Static vm:Routes.Login}"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <ShellContent
        Route="{x:Static vm:Routes.Register}"
        ContentTemplate="{DataTemplate pages:RegisterPage}" />

    <ShellContent
        Route="{x:Static vm:Routes.Home}"
        ContentTemplate="{DataTemplate pages:HomePage}" />

</Shell>

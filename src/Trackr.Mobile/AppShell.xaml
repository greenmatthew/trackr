<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Trackr.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Trackr.Mobile.Pages"
    Title="Trackr"
    FlyoutBehavior="Disabled">

    <!-- Three flat routes, no tabs and no flyout: at milestone 3 the app has exactly one
         signed-in screen, so there is nothing to navigate between. Milestone 4 (CLAUDE.md
         section 9) decides the real structure, at which point Home becomes a TabBar holding
         the chat and stats tabs and these two auth routes move out of the main stack.

         Route names are duplicated in Platform/ShellNavigationService.cs, which is what the
         navigation service uses - keep them in step. -->

    <ShellContent
        Route="server-setup"
        ContentTemplate="{DataTemplate pages:ServerSetupPage}" />

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <ShellContent
        Route="home"
        ContentTemplate="{DataTemplate pages:HomePage}" />

</Shell>

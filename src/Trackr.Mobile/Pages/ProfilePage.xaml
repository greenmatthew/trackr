<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trackr.Mobile.Core.ViewModels;assembly=Trackr.Mobile.Core"
    x:DataType="vm:ProfileViewModel"
    Title="Profile">

    <!-- The account details that lived on the milestone 3 home screen. None of it was ever
         about the home screen; Home is the day's totals now.

         Overrides the shell's title view deliberately: this page is what the avatar opens,
         so showing the avatar again on it would offer to open the page you are on. -->

    <Shell.TitleView>
        <Label
            Text="Profile"
            FontSize="20"
            FontAttributes="Bold"
            VerticalOptions="Center"
            TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Border
                Style="{StaticResource AvatarCircle}"
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center">

                <Grid>

                    <Label
                        Text="{Binding Initials}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryDarkText}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="{Binding HasPicture, Converter={StaticResource InvertedBoolConverter}}" />

                    <Image
                        Source="{Binding Picture, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                        Aspect="AspectFill"
                        IsVisible="{Binding HasPicture}" />

                </Grid>

            </Border>

            <!-- Two buttons rather than a menu on the circle: "remove" only exists when there
                 is something to remove, and a tap target that changes meaning is worse than
                 one that comes and goes. -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">

                <Button
                    Text="Change picture"
                    Style="{StaticResource LinkAction}"
                    Command="{Binding ChangePictureCommand}"
                    IsEnabled="{Binding IsPictureBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button
                    Text="Remove"
                    Style="{StaticResource LinkAction}"
                    Command="{Binding RemovePictureCommand}"
                    IsVisible="{Binding HasPicture}"
                    IsEnabled="{Binding IsPictureBusy, Converter={StaticResource InvertedBoolConverter}}" />

            </HorizontalStackLayout>

            <Label
                Text="{Binding PictureError}"
                Style="{StaticResource ErrorText}"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding PictureError, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Account" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding Email}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Server" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding ServerDescription}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Two-factor authentication" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding TwoFactorDescription}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Changing your password and managing 2FA happen on the website."
                Style="{StaticResource Caption}" />

            <Button
                Text="Sign out"
                Style="{StaticResource PrimaryAction}"
                Command="{Binding SignOutCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

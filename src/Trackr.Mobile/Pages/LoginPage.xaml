<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trackr.Mobile.Core.ViewModels;assembly=Trackr.Mobile.Core"
    x:DataType="vm:LoginViewModel"
    Title="Sign in"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">

            <Label
                Text="Sign in"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding ServerDescription}"
                HorizontalTextAlignment="Center"
                FontSize="13"
                Opacity="0.7" />

            <Entry
                Placeholder="Email"
                Text="{Binding Email}"
                Keyboard="Email"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Entry
                Placeholder="Password"
                Text="{Binding Password}"
                IsPassword="True"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                ReturnType="Go"
                ReturnCommand="{Binding SignInCommand}" />

            <!-- Revealed only once the server reports that a code is owed, so an account
                 without 2FA never sees it. -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding NeedsTwoFactor}">

                <Label
                    Text="Enter the code from your authenticator app."
                    FontSize="13"
                    Opacity="0.75" />

                <Entry
                    Placeholder="123456"
                    Text="{Binding TwoFactorCode}"
                    Keyboard="Numeric"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    ReturnType="Go"
                    ReturnCommand="{Binding SignInCommand}" />

                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding UseRecoveryCode}" />
                    <Label
                        Text="Use a recovery code instead"
                        VerticalOptions="Center"
                        FontSize="13" />
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <Label
                Text="{Binding Error}"
                IsVisible="{Binding Error, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                TextColor="{AppThemeBinding Light={StaticResource ErrorOnLight}, Dark={StaticResource ErrorOnDark}}" />

            <Button
                Text="Sign in"
                Command="{Binding SignInCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                HeightRequest="52" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <!-- The only route to sign-up. Without it a server with no accounts is a dead
                 end on the phone, exactly as the web login page was before it gained the
                 same link. -->
            <Button
                Text="No account yet? Create one"
                Command="{Binding GoToRegisterCommand}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryOnLight}, Dark={StaticResource PrimaryDark}}"
                FontSize="13" />

            <Button
                Text="Use a different server"
                Command="{Binding ChangeServerCommand}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryOnLight}, Dark={StaticResource PrimaryDark}}"
                FontSize="13" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

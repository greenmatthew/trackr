<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.TrendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutrition="clr-namespace:Trackr.Mobile.Core.Nutrition;assembly=Trackr.Mobile.Core"
    xmlns:vm="clr-namespace:Trackr.Mobile.Core.ViewModels;assembly=Trackr.Mobile.Core"
    x:DataType="vm:TrendsViewModel">

    <!-- Week and month, in the "basic form" CLAUDE.md section 1 asks for: rolling summaries and a
         simple trend, not analytics.

         The chart is two dozen scaled rectangles rather than a charting package. A dependency for
         this would be a licence to check and a bundle to carry for something the layout can
         already do, and the bars are bound to a fraction so how tall the chart is stays a
         question for the page. -->

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Picker
                ItemsSource="{Binding RangeLabels}"
                SelectedIndex="{Binding SelectedRange}"
                AutomationId="TrendRange" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />

            <Label
                Text="{Binding Problem}"
                Style="{StaticResource ErrorText}"
                IsVisible="{Binding Problem, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasAnything}">

                <Label
                    Text="{Binding Headline}"
                    Style="{StaticResource PageTitle}"
                    HorizontalOptions="Center" />

                <!-- Says what the average is an average of. The server divides by the days that
                     have something on them, so showing the figure without saying so would imply a
                     fuller week than there was. -->
                <Label
                    Text="{Binding Detail}"
                    Style="{StaticResource Caption}"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>

            <Border
                Style="{StaticResource Card}"
                IsVisible="{Binding HasAnything}"
                Padding="12">

                <CollectionView
                    ItemsSource="{Binding Days}"
                    ItemsLayout="HorizontalList"
                    HeightRequest="160">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayBar">

                            <Grid RowDefinitions="*,Auto" WidthRequest="34" Padding="2">

                                <!-- Bottom-aligned inside a fixed row, with the height coming from
                                     the fraction. A day with nothing logged draws no bar at all
                                     rather than a floor, because a blank day and a small day are
                                     different facts. -->
                                <BoxView
                                    VerticalOptions="End"
                                    HeightRequest="{Binding Fraction, Converter={StaticResource BarHeight}}"
                                    IsVisible="{Binding HasAnything}"
                                    Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">

                                    <!-- The same vocabulary as the targets on Home: a ceiling passed
                                         is a warning, a floor reached is done, and a day still short
                                         of a floor is neither. -->
                                    <BoxView.Triggers>
                                        <DataTrigger
                                            TargetType="BoxView"
                                            Binding="{Binding IsDone}"
                                            Value="True">
                                            <Setter
                                                Property="Color"
                                                Value="{AppThemeBinding Light={StaticResource SuccessOnLight}, Dark={StaticResource Success}}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            TargetType="BoxView"
                                            Binding="{Binding IsOver}"
                                            Value="True">
                                            <Setter
                                                Property="Color"
                                                Value="{AppThemeBinding Light={StaticResource WarningOnLight}, Dark={StaticResource Warning}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>

                                </BoxView>

                                <!-- The target line, drawn per column so that it crosses the whole
                                     chart without the horizontal list needing an overlay. A
                                     transparent block of exactly the target's height, with the line
                                     itself sitting on top of it. -->
                                <Grid
                                    VerticalOptions="End"
                                    HeightRequest="{Binding TargetFraction, Converter={StaticResource BarHeight}}"
                                    IsVisible="{Binding HasTarget}"
                                    InputTransparent="True">

                                    <BoxView
                                        VerticalOptions="Start"
                                        HeightRequest="1"
                                        Opacity="0.7"
                                        Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                                </Grid>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Label}"
                                    FontSize="9"
                                    LineBreakMode="TailTruncation"
                                    HorizontalTextAlignment="Center" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Border>

            <!-- Which way the line reads. The same picture is a good week or a bad one depending
                 on whether the target is a floor or a ceiling, so the line is never left to speak
                 for itself. -->
            <Label
                Text="{Binding TargetCaption}"
                Style="{StaticResource Caption}"
                HorizontalOptions="Center"
                IsVisible="{Binding HasTarget}" />

            <Label
                Text="An average day"
                Style="{StaticResource FieldLabel}"
                IsVisible="{Binding HasAnything}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Nutrients}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="nutrition:NutrientRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DisplayName}" />
                            <Label Grid.Column="1" Text="{Binding Amount}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="8"
                IsVisible="{Binding HasAnything, Converter={StaticResource InvertedBoolConverter}}">

                <Label
                    Text="Nothing to summarise yet"
                    Style="{StaticResource PageTitle}"
                    HorizontalOptions="Center" />

                <Label
                    Text="Log a few meals and a week's shape will start to show here."
                    Style="{StaticResource Caption}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

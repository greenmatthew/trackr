<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.TrendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Week and month summaries, and later the place goals are shown against (CLAUDE.md
         9.12). Separate from Home so that "what have I eaten today" never involves scrolling
         past a trend chart to reach it.

         Empty until milestone 11. -->

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">

        <Label
            Text="Trends"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Weekly and monthly summaries will appear here once there is something to summarise."
            HorizontalTextAlignment="Center"
            FontSize="13"
            Opacity="0.6" />

    </VerticalStackLayout>

</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.LoadingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Gray950}">

    <!-- Deliberately NOT theme-aware. This is the continuation of the Android splash
         screen, which is a fixed #122E42 (see MauiSplashScreen in the csproj), so matching
         it means the handoff is invisible rather than a flash of the wrong colour. A light
         theme picks up the real background one moment later, when a shell replaces this.

         Shown only while App works out which shell to open - a keystore read plus, if there
         is a token, one call to /me. It is not a screen the user can reach or act on, so it
         has no view model and no DI. -->

    <ActivityIndicator
        IsRunning="True"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Color="{StaticResource Primary}" />

</ContentPage>

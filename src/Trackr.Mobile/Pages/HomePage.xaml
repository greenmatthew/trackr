<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trackr.Mobile.Core.ViewModels;assembly=Trackr.Mobile.Core"
    x:DataType="vm:HomeViewModel">

    <!-- Today's totals: the output surface, and the tab the app opens on.

         An honest empty state rather than a dashboard of invented numbers. Nothing can be
         logged until the cascade exists (milestone 9) and there is nothing to aggregate until
         the data layer does (milestone 6); milestone 11 fills this in from the nutrient
         snapshots on LogItems. The shape is here so that work is a fill-in, not a redesign. -->

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">

        <Label
            Text="{Binding Today}"
            FontSize="13"
            Opacity="0.6"
            HorizontalOptions="Center" />

        <Label
            Text="Nothing logged yet"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Your day's calories and nutrients will appear here once meal logging arrives."
            HorizontalTextAlignment="Center"
            FontSize="13"
            Opacity="0.6" />

    </VerticalStackLayout>

</ContentPage>

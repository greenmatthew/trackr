<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trackr.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutrition="clr-namespace:Trackr.Mobile.Core.Nutrition;assembly=Trackr.Mobile.Core"
    xmlns:storage="clr-namespace:Trackr.Mobile.Core.Storage;assembly=Trackr.Mobile.Core"
    xmlns:vm="clr-namespace:Trackr.Mobile.Core.ViewModels;assembly=Trackr.Mobile.Core"
    x:DataType="vm:HomeViewModel">

    <!-- Today so far. CLAUDE.md section 1 calls this core rather than polish: logging a meal and
         immediately seeing the day move is the loop the app is built around, which is why it sits
         beside the chat rather than behind a menu.

         The date is the phone's and is for display only; the totals are the server's, for an
         account whose day boundary follows its own time zone rather than the phone's. -->

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="{Binding Today}"
                Style="{StaticResource Caption}"
                HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />

            <!-- Meals confirmed on this phone that the server has not taken yet. It sits here, above
                 the total, because the total is the number it contradicts: leaving three queued
                 meals out of "today so far" without saying so would be exactly the quiet wrong
                 figure CLAUDE.md section 2 is written against.

                 A row only offers Send again and Discard once it has stopped retrying by itself.
                 Discarding is the only way a confirmed meal is ever lost, so it takes a deliberate
                 tap and never happens on the app's own initiative. -->
            <Border
                Style="{StaticResource Card}"
                IsVisible="{Binding HasQueued}"
                Stroke="{AppThemeBinding Light={StaticResource WarningOnLight}, Dark={StaticResource Warning}}">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="{Binding QueuedSummary}"
                        AutomationId="QueuedSummary"
                        TextColor="{AppThemeBinding Light={StaticResource WarningOnLight}, Dark={StaticResource Warning}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Queued}" Spacing="8">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="storage:QueuedMeal">
                                <VerticalStackLayout Spacing="2">

                                    <Label Text="{Binding Summary}" Style="{StaticResource Body}" />

                                    <Label
                                        Text="{Binding LastError}"
                                        Style="{StaticResource ErrorText}"
                                        IsVisible="{Binding Rejected}" />

                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding Rejected}">

                                        <Button
                                            Text="Send again"
                                            Style="{StaticResource LinkAction}"
                                            AutomationId="RetryQueued"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=RetryQueuedCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="Discard"
                                            Style="{StaticResource LinkAction}"
                                            AutomationId="DiscardQueued"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=DiscardQueuedCommand}"
                                            CommandParameter="{Binding .}" />

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Never drawn as an empty day: "you have eaten nothing" and "the server did not
                 answer" look identical if you let them, and only one is the user's doing. -->
            <Label
                Text="{Binding Problem}"
                Style="{StaticResource ErrorText}"
                IsVisible="{Binding Problem, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasAnything}">

                <Label
                    Text="{Binding EnergyText}"
                    Style="{StaticResource PageTitle}"
                    HorizontalOptions="Center" />

                <!-- Bound rather than written in: the account chooses whether energy reads as
                     kilocalories or kilojoules, and a fixed label would contradict the number
                     above it. -->
                <Label Text="{Binding EnergyUnitText}" Style="{StaticResource Caption}" HorizontalOptions="Center" />

            </VerticalStackLayout>

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12"
                IsVisible="{Binding HasAnything}">

                <VerticalStackLayout>
                    <Label Text="Fat" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding FatText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Carbs" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding CarbohydrateText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Protein" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding ProteinText}" />
                </VerticalStackLayout>

            </Grid>

            <!-- Targets, above the breakdown. A ceiling passed is drawn as a warning and a floor
                 reached as done; a floor not yet reached is a day in progress rather than a
                 failure, which is what keeps this from being an accusation at breakfast. -->
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Goals}"
                IsVisible="{Binding HasGoals}"
                Spacing="10">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:GoalRow">
                        <VerticalStackLayout Spacing="2">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="{Binding DisplayName}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Amount}"
                                    Style="{StaticResource FieldLabel}" />

                            </Grid>

                            <ProgressBar
                                Progress="{Binding Fraction}"
                                ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                            <Label
                                Text="over"
                                Style="{StaticResource ErrorText}"
                                IsVisible="{Binding IsOver}" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <!-- Only what today actually reported. A row per known nutrient with a dash against the
                 unmeasured ones would read as a list of zeroes. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Nutrients}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="nutrition:NutrientRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DisplayName}" />
                            <Label Grid.Column="1" Text="{Binding Amount}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Text="Daily targets"
                AutomationId="OpenGoals"
                Command="{Binding OpenGoalsCommand}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasAnything, Converter={StaticResource InvertedBoolConverter}}">

                <Label
                    Text="Nothing logged yet"
                    Style="{StaticResource PageTitle}"
                    HorizontalOptions="Center" />

                <Label
                    Text="Tell the Chat tab what you ate and it will show up here."
                    Style="{StaticResource Caption}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

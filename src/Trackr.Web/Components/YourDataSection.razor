@inject AuthClient Auth
@inject NavigationManager Navigation

@* Export and deletion, together, because they are the same question asked twice: what happens to
   your data. The export is offered first on purpose - leaving is easier to consider once the data
   is somewhere else. *@

<section class="settings-section">
    <h2>Your data</h2>

    <p>
        Everything this account holds — your profile, targets, every logged meal and the items you
        added to the catalog — as a JSON file.
    </p>

    @* A plain link rather than a fetch: the browser is already carrying the session cookie and
       nginx serves this origin, so the download needs no JavaScript at all. *@
    <p><a href="api/account/export" download>Download my data</a></p>

    <p class="field-hint">
        Meal photographs are listed in the file rather than embedded in it, with a link to each —
        a few hundred of them as text would make a file nothing can open.
    </p>
</section>

<section class="settings-section">
    <h2>Delete this account</h2>

    @if (_problem is not null)
    {
        <div class="notice notice--bad" role="alert">
            @foreach (var message in _problem)
            {
                <p>@message</p>
            }
        </div>
    }

    <p>
        This removes your account, your log, your targets and the catalog items only you can see.
        Items you shared with the household stay, because other people's recipes are made of them.
        <strong>It cannot be undone.</strong>
    </p>

    <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="delete-account">
        <DataAnnotationsValidator />

        <label for="deletePassword">Current password</label>
        <InputText id="deletePassword" @bind-Value="_request.Password" type="password"
                   autocomplete="current-password" />
        <ValidationMessage For="() => _request.Password" />

        <label for="deleteConfirmation">Type @DeleteAccountRequest.RequiredConfirmation to confirm</label>
        <InputText id="deleteConfirmation" @bind-Value="_request.Confirmation" autocomplete="off" />
        <ValidationMessage For="() => _request.Confirmation" />

        <button type="submit" class="danger" disabled="@_busy">
            @(_busy ? "Deleting…" : "Delete my account")
        </button>
    </EditForm>
</section>

@code {
    private readonly DeleteAccountRequest _request = new();
    private IReadOnlyList<string>? _problem;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _problem = null;

        try
        {
            var result = await Auth.DeleteAccountAsync(_request);

            if (result.Succeeded)
            {
                // A reload rather than a route change: the account this page was rendered for no
                // longer exists, and every component still on screen would be asking about it.
                Navigation.NavigateTo("login", forceLoad: true);

                return;
            }

            _problem = result.Problem!.AllMessages.ToArray();
            _request.Password = "";
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/forgot-password"
@attribute [AllowAnonymous]
@inject AuthClient Auth

<PageTitle>Forgot your password — Trackr</PageTitle>

<main class="auth-card">
    <h1>Forgot your password</h1>

    @if (_sent)
    {
        @* The same message either way. The server deliberately does not reveal whether an
           address has an account, and neither should this page. *@
        <div class="notice notice--good" role="status">
            <p>If that address has an account, a reset link is on its way.</p>
            <p class="field-hint">
                No email server is configured by default on a self-hosted Trackr. If that is the
                case here, the link is written to the backend log instead — see the README.
            </p>
        </div>
        <p class="auth-card__aside"><a href="login">Back to sign in</a></p>
    }
    else
    {
        @if (_problem is not null)
        {
            <div class="notice notice--bad" role="alert">
                @foreach (var message in _problem)
                {
                    <p>@message</p>
                }
            </div>
        }

        <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="forgot-password">
            <DataAnnotationsValidator />

            <label for="email">Email</label>
            <InputText id="email" @bind-Value="_request.Email" autocomplete="username" type="email" />
            <ValidationMessage For="() => _request.Email" />

            <button type="submit" disabled="@_busy">@(_busy ? "Sending…" : "Send reset link")</button>
        </EditForm>

        <p class="auth-card__aside"><a href="login">Back to sign in</a></p>
    }
</main>

@code {
    private readonly ForgotPasswordRequest _request = new();
    private IReadOnlyList<string>? _problem;
    private bool _sent;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _problem = null;

        try
        {
            var result = await Auth.ForgotPasswordAsync(_request);

            if (result.Succeeded)
            {
                _sent = true;
            }
            else
            {
                _problem = result.Problem!.AllMessages.ToArray();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

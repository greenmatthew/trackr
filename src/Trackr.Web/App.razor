<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* AuthorizeRouteView rather than RouteView: _Imports.razor applies [Authorize] to
           every page, so this is what enforces it and what sends a signed-out visitor to
           the login page instead of rendering an empty screen. *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorizing>
                @* Shown for the moment it takes GET /api/auth/me to answer on a cold load. *@
                <p class="auth-checking" role="status">Checking your session…</p>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

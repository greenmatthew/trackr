@inject AuthClient Auth

<section class="settings-section">
    <h2>Password</h2>

    @if (_saved)
    {
        <div class="notice notice--good" role="status">
            <p>Your password has been changed. Other devices have been signed out.</p>
        </div>
    }

    @if (_problem is not null)
    {
        <div class="notice notice--bad" role="alert">
            @foreach (var message in _problem)
            {
                <p>@message</p>
            }
        </div>
    }

    <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="change-password">
        <DataAnnotationsValidator />

        <label for="currentPassword">Current password</label>
        <InputText id="currentPassword" @bind-Value="_request.CurrentPassword" type="password"
                   autocomplete="current-password" />
        <ValidationMessage For="() => _request.CurrentPassword" />

        <label for="newPassword">New password</label>
        <InputText id="newPassword" @bind-Value="_request.NewPassword" type="password"
                   autocomplete="new-password" />
        <ValidationMessage For="() => _request.NewPassword" />
        <p class="field-hint">At least 12 characters.</p>

        <button type="submit" disabled="@_busy">@(_busy ? "Saving…" : "Change password")</button>
    </EditForm>
</section>

@code {
    private readonly ChangePasswordRequest _request = new();
    private IReadOnlyList<string>? _problem;
    private bool _saved;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _problem = null;
        _saved = false;

        try
        {
            var result = await Auth.ChangePasswordAsync(_request);

            if (result.Succeeded)
            {
                _saved = true;
                _request.CurrentPassword = "";
                _request.NewPassword = "";
            }
            else
            {
                _problem = result.Problem!.AllMessages.ToArray();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

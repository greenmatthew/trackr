@page "/reset-password"
@attribute [AllowAnonymous]
@inject AuthClient Auth
@inject NavigationManager Navigation

<PageTitle>Set a new password — Trackr</PageTitle>

<main class="auth-card">
    <h1>Set a new password</h1>

    @if (_done)
    {
        <div class="notice notice--good" role="status">
            <p>Your password has been changed. Sign in with it now.</p>
        </div>
        <p class="auth-card__aside"><a href="login">Go to sign in</a></p>
    }
    else if (string.IsNullOrWhiteSpace(Code))
    {
        <div class="notice notice--bad" role="alert">
            <p>This page needs the link from your reset email. Request a new one to continue.</p>
        </div>
        <p class="auth-card__aside"><a href="forgot-password">Request a reset link</a></p>
    }
    else
    {
        @if (_problem is not null)
        {
            <div class="notice notice--bad" role="alert">
                @foreach (var message in _problem)
                {
                    <p>@message</p>
                }
            </div>
        }

        <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="reset-password">
            <DataAnnotationsValidator />

            <label for="email">Email</label>
            <InputText id="email" @bind-Value="_request.Email" autocomplete="username" type="email" />
            <ValidationMessage For="() => _request.Email" />

            <label for="newPassword">New password</label>
            <InputText id="newPassword" @bind-Value="_request.NewPassword" type="password"
                       autocomplete="new-password" />
            <ValidationMessage For="() => _request.NewPassword" />
            <p class="field-hint">At least 12 characters.</p>

            <button type="submit" disabled="@_busy">@(_busy ? "Saving…" : "Set password")</button>
        </EditForm>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    private readonly ResetPasswordRequest _request = new();
    private IReadOnlyList<string>? _problem;
    private bool _done;
    private bool _busy;

    protected override void OnInitialized()
    {
        _request.Email = Email ?? "";
        _request.Code = Code ?? "";
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _problem = null;

        try
        {
            var result = await Auth.ResetPasswordAsync(_request);

            if (result.Succeeded)
            {
                // Deliberately not signed in - the server does not hand out a session for
                // proving possession of a reset link. Go through the normal login, 2FA
                // included.
                _done = true;
            }
            else
            {
                _problem = result.Problem!.AllMessages.ToArray();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

# Copy to .env next to docker-compose.yml and fill in, or set these as stack
# environment variables in Portainer. .env is gitignored - never commit real
# credentials.
#
# Only needed for the deployment stack; docker-compose.dev.yml is self-contained.

# Required. Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional - defaults shown.
POSTGRES_DB=trackr
POSTGRES_USER=trackr

# Name of the pre-existing external Docker network that the reverse proxy is on.
PROXY_NETWORK=proxy

# Tag applied to the images this stack builds.
TRACKR_TAG=latest

# --- Password reset delivery (all optional) ---------------------------------
#
# Left unset, Trackr writes password-reset links to the backend log rather than
# emailing them, and you retrieve one with:
#
#     docker compose logs backend | grep -A3 "was not sent"
#
# That is a deliberate default: it needs no SMTP credentials. The trade-off is
# that anyone who can read the backend logs can take over an account.
#
# Set TRACKR_EMAIL_PROVIDER=Smtp and fill in the rest to send real email instead.
TRACKR_EMAIL_PROVIDER=Log
TRACKR_SMTP_HOST=
TRACKR_SMTP_PORT=587
TRACKR_SMTP_USE_SSL=true
TRACKR_SMTP_USER=
TRACKR_SMTP_PASSWORD=
TRACKR_SMTP_FROM=

# Base URL used in reset and invite links. Only needed if they come out with the
# wrong host - normally it is derived from the request.
TRACKR_PUBLIC_BASE_URL=

# --- Auth rate limits (optional) --------------------------------------------
#
# Per-window request budgets on the auth endpoints, shared by everyone behind the
# same address. Raise them if a household keeps tripping the limit.
TRACKR_LOGIN_RATE_LIMIT=10
TRACKR_SENSITIVE_RATE_LIMIT=5

# Barcode lookups per minute. This one is not protecting you - it keeps Trackr a
# well-behaved caller of a free, volunteer-run service.
TRACKR_LOOKUP_RATE_LIMIT=60

# --- Open Food Facts (optional) ---------------------------------------------
#
# The nutrition database behind barcode lookups. A barcode NUMBER is the only thing
# Trackr ever sends off your server - never a photo, never anything about you.
#
# Setting a contact address is encouraged: Open Food Facts asks API callers to
# identify themselves so they can get in touch about a misbehaving client rather
# than simply blocking it.
TRACKR_OFF_CONTACT_EMAIL=

# Set to false for no outbound requests at all. Packaged food then falls to the AI,
# which is slower and less accurate than reading the label from the database.
TRACKR_OFF_ENABLED=true

# Point at a mirror, or at https://world.openfoodfacts.net/ (their staging server)
# to experiment without adding noise to the real database's traffic.
TRACKR_OFF_BASE_ADDRESS=https://world.openfoodfacts.org/

# How long to wait for one lookup. Kept short on purpose: falling back to the AI is a
# perfectly good outcome, and somebody is watching a chat message spin.
TRACKR_OFF_TIMEOUT_SECONDS=10

# --- Local AI (optional) ----------------------------------------------------
#
# The vision model that reads a photo when the barcode path cannot - home cooking,
# anything unpackaged, anything Open Food Facts has never heard of. It runs in the
# `ollama` container on your own hardware and NOTHING it sees leaves the machine.
#
# Set to false to turn it off. Barcode lookups keep working; everything else stops.
TRACKR_OLLAMA_ENABLED=true

# CPU-only servers: leave this alone. gemma4:26b is a mixture-of-experts model, so
# only about 3.8B of its 25.2B parameters run per token - it is the FAST one on a
# processor, and beats the smaller dense 12B on both speed and accuracy there. The
# cost is about 18 GB of RAM held while it is loaded, and an 18 GB first download.
TRACKR_OLLAMA_MODEL=gemma4:26b
# If you have a graphics card, the dense 31B answers better. On a processor it is
# several times slower for a modest gain.
#TRACKR_OLLAMA_MODEL=gemma4:31b

# How long the model stays in memory after answering. Short, so several gigabytes are
# not held all day between meals - but not zero, because reloading it costs seconds
# and correcting a photo means asking twice in a row.
TRACKR_OLLAMA_KEEP_ALIVE=5m

# How long to wait for one analysis. Reading a label on a processor is tens of seconds
# to a couple of minutes, so this is deliberately long.
#
# It must stay UNDER the read timeout of your own reverse proxy. nginx defaults to 60
# seconds, which will cut an analysis off before this ever fires - see the wiki's
# Troubleshooting page if analyses fail after exactly a minute.
TRACKR_OLLAMA_TIMEOUT_SECONDS=240

# The context window, in tokens. Set here rather than left to Ollama, which sizes it
# from graphics memory and so gives a machine without a card a window far too small.
#
# Photos are expensive: one 1280-pixel image measures at roughly 7000 tokens against a
# small vision model, so the obvious guess of 8192 fits one picture and then fails on
# two. If an analysis comes back saying your photos needed more room than the model
# has, this is the number to raise - at the cost of RAM.
TRACKR_OLLAMA_CONTEXT_LENGTH=16384

# How many photos one analysis may look at, and how far each is scaled down first.
# Your stored photo is never altered - only the copy the model sees.
#
# These two and the context length above are one setting in three parts: more photos,
# or bigger ones, need a larger window. Lowering the edge size is the cheaper fix and
# costs you legibility - below about 768 pixels a model stops being able to read the
# small print on a label, which is the whole job.
TRACKR_OLLAMA_MAX_IMAGES=4
TRACKR_OLLAMA_MAX_IMAGE_EDGE=1280

# Meal analyses per five minutes. Unlike the limits above, this one is protecting your
# own processor rather than an account or somebody else's service.
TRACKR_ANALYSIS_RATE_LIMIT=30

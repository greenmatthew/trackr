<Project>

  <!-- Central Package Management: every NuGet version lives here, and the
       csproj files reference packages without a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below raise a transitive dependency's version
         without having to take a direct PackageReference on it. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <!-- Debug-only: lets the API host the WASM app for the `dotnet watch` loop. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <!-- AuthorizeRouteView / AuthorizeView / AddCascadingAuthenticationState. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Identity / security">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <!-- Keeps the data-protection key ring in Postgres. Without it the keys live
         in the container filesystem, which has no volume, so every redeploy would
         silently invalidate every session cookie and password-reset token. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <!-- Renders the 2FA enrolment QR code server-side. Chosen over QRCoder, whose
         1.7+ releases pull System.Drawing.Common on net6.0 - a Windows-oriented
         dependency in a Linux container. This one has no dependencies at all. -->
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
    <!-- Barcode decoding for the cascade's first stage (milestone 7). Apache-2.0, so fine
         under the AGPL (CLAUDE.md section 10). -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- ZXing reads luminance, not files, so it needs an image decoder underneath. This
         binding is the adapter; SkiaSharp is the decoder. Apache-2.0 and MIT respectively.
         SixLabors.ImageSharp would have been the obvious alternative and is deliberately
         NOT used: since 3.0 it ships under the Six Labors Split License rather than
         Apache-2.0, which is source-available and fails the section 10 licence rule. -->
    <PackageVersion Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
    <!-- Pinned to the major the binding above targets rather than the newest release: a
         SkiaSharp major bump would be an API change under a package that is not rebuilt
         against it. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.1" />
    <!-- The native library SkiaSharp calls, and the reason a green build can still throw
         DllNotFoundException at runtime. The API image is aspnet:10.0-alpine, which is musl
         rather than glibc, and this package is the variant carrying a linux-musl-x64 build.
         "NoDependencies" additionally means no fontconfig, which suits a decoder that never
         draws text. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup Label="Mobile (MAUI Android)">
    <!-- The MAUI framework itself. Versioned here like everything else, but note it is
         paired with the `maui-android` workload rather than restored in isolation - the
         workload supplies the Android SDK bindings this builds against. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <!-- Source-generated MVVM: [ObservableProperty] and [RelayCommand]. Used by
         Trackr.Mobile.Core, which is a plain net10.0 library, so this is deliberately not
         a MAUI-specific package. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Converters, behaviors, toast/snackbar and popups. Needs .UseMauiCommunityToolkit()
         in MauiProgram - it is not purely additive like the MVVM toolkit. -->
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.0" />
    <!-- IHttpClientFactory. Taken chiefly for AddHttpMessageHandler, which is how the
         bearer-token attach-and-refresh handler is wired - the same shape as the web app's
         UnauthorizedResponseHandler. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- Retry, timeout and circuit breaker. A phone roams between wifi, cellular and VPN,
         so transient failures are normal here in a way they are not on the server. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- builder.Logging.AddDebug(). MAUI ships the logging abstractions but not the Debug
         provider, which is the one that reaches `adb logcat`. Debug builds only. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <!-- The phone's local store. Referenced by Trackr.Mobile.Core, not the MAUI project, so
         it can be tested against `Data Source=:memory:` by plain `dotnet test`. Deliberately
         NOT EF Core on this side: the schema is a handful of tables written by hand, and a
         reflection-driven ORM is a fight with the Android linker for nothing. MIT, and the
         SQLitePCLRaw bundle it pulls for the native library is Apache-2.0 - both fine under
         the AGPL (CLAUDE.md section 10). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <!-- Npgsql 10.0.3 requires Microsoft.EntityFrameworkCore [10.0.4, 11.0.0). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Transitive pins">
    <!-- Microsoft.AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0, which
         is affected by GHSA-v5pm-xwqc-g5wc (stack overflow on a circular schema
         reference while *parsing* a document). We only generate documents, so we
         are not exposed, but 2.7.5 is the first patched release. Drop this pin
         once Microsoft.AspNetCore.OpenApi ships with a patched version itself. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.6" />
    <!-- Microsoft.Data.Sqlite 10.0.10 pulls SQLitePCLRaw 2.1.11, whose native library is
         SQLite 3.49.1 - before the 3.50.2 that fixes CVE-2025-6965 / GHSA-2m69-gcr7-jv3q, a
         memory-corruption bug reachable through a crafted query. 2.1.12 carries SQLite
         3.53.3 and is otherwise the same 2.1.x line Microsoft.Data.Sqlite expects; the 3.0.x
         releases restructure the packages around a separate `SQLite` package and are not a
         drop-in. Pinning the bundle lifts the lib, provider and core packages with it.
         Verified by reading the version string out of the .so in each package, because the
         advisory itself lists no fixed version. Drop this pin once Microsoft.Data.Sqlite
         ships against a patched SQLitePCLRaw itself. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup Label="Diagnostics">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- The tests run against a real throwaway Postgres. EF's InMemory provider
         cannot apply migrations at all, and SQLite would force EnsureCreated,
         so in either case the migrations - the thing most worth testing - would
         never be exercised. Cost: `dotnet test` needs Docker. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Substitutes for the API client in the mobile view-model tests. Trackr.Api.Tests
         deliberately uses no mocking library - it drives the real application instead - so
         this is scoped to Trackr.Mobile.Tests, where there is no real app to drive. -->
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
  </ItemGroup>

</Project>
